{
  "name": "ai-motion-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "pnpm --dir ./apps/server dev",
    "dev:web": "pnpm --dir ./apps/web dev",
    "build:server": "pnpm --dir ./apps/server build",
    "build:web": "pnpm --dir ./apps/web build",
    "build:all": "pnpm --dir ./apps/server build && pnpm --dir ./apps/web build",
    "preview": "pnpm --dir ./apps/web preview",
    "setup:python": "node scripts/setup-python.mjs",
    "typecheck": "pnpm --dir ./apps/server typecheck && pnpm --dir ./apps/web typecheck"
  }
}
