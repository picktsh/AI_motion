# ---- 依赖目录 ----
node_modules/
.venv/
__pycache__/
*.py[cod]

# ---- 本地工具二进制 ----
studio/bin/

# ---- 渲染产物与中间实例（成片、抽帧、预览、prepare 实例、输入素材）----
studio/videos/

# ---- BGM 素材 ----
studio/bgm/

# ---- TTS 音频产物（保留 segments.json 词边界清单）----
studio/tts/segments/*.mp3
studio/tts/segments/*.vtt
studio/tts/samples/*.mp3

# ---- 系统与编辑器 ----
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# ---- 本地环境变量（.env 入库默认值，仅忽略本地覆盖）----
.env.local
.env.*.local

# ---- 第三方模板下载缓存（锁清单 templates.lock.json 入库）----
studio/templates-cache/

# ---- 构建产物 ----
apps/web/dist/
apps/server/dist/

# ---- 项目产物与中间实例（清单 json/txt 保留，实例与媒体不入库）----
studio/projects/*/instance*/
studio/projects/*/output/*.mp4
studio/projects/*/output/*.wav
studio/projects/*/output/*.png
studio/projects/*/output/*.webm
studio/projects/*/output/*.gif

# ---- 模板包（含个人调用标识，禁止入库）----
studio/templates/
studio/templates-cache/
